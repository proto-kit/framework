{
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": [
          "build",
          "prisma:generate",
          "lint",
          "test",
          "integration"
        ]
      }
    }
  },
  "targetDefaults": {
    "prisma:generate": {
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/prisma/*",
        "{projectRoot}/prisma/**/*"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig.json"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    }
  }
}
